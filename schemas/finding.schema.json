{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torusguard.dev/schemas/finding.schema.json",
  "title": "TorusGuardNormalizedFinding",
  "description": "Normalized finding object schema for TorusGuard v0.5.0 finding lifecycle.",
  "type": "object",
  "required": [
    "id",
    "rule_id",
    "title",
    "category",
    "severity",
    "confidence",
    "lifecycle_stage",
    "status",
    "affected_area",
    "rationale",
    "evidence",
    "remediation",
    "verification_steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this finding instance (e.g. TG-FIND-2026-001 or UUID)."
    },
    "rule_id": {
      "type": "string",
      "pattern": "^TG-[A-Z0-9]+-[0-9]{3}$",
      "description": "Canonical TorusGuard Rule ID (e.g. TG-AUTH-007, TG-SEC-001)."
    },
    "title": {
      "type": "string",
      "description": "Concise, human-readable finding title."
    },
    "category": {
      "type": "string",
      "enum": [
        "authentication-authorization",
        "input-validation-encoding",
        "data-access-orm",
        "file-upload-handling",
        "secrets-configuration",
        "dependency-supply-chain",
        "network-ssrf-boundaries",
        "business-logic-rate-limiting",
        "client-cache-platform"
      ],
      "description": "Normalized taxonomy category."
    },
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low", "Informational"],
      "description": "Normalized risk severity level."
    },
    "confidence": {
      "type": "string",
      "enum": ["Confirmed", "Likely", "Needs Review", "Informational", "Not Applicable"],
      "description": "Evidence-backed confidence level."
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": ["Detect", "Classify", "Verify", "Remediate", "Recheck", "Archive"],
      "description": "Current lifecycle phase of the finding."
    },
    "status": {
      "type": "string",
      "enum": ["Open", "In Verification", "Remediation Proposed", "Remediated", "Verified Safe", "Suppressed", "Archived"],
      "description": "Current operational status of the finding."
    },
    "affected_area": {
      "type": "object",
      "required": ["component", "target_path"],
      "properties": {
        "component": { "type": "string", "description": "Module, service, API endpoint, or component name." },
        "target_path": { "type": "string", "description": "Relative file path or configuration identifier." },
        "start_line": { "type": "integer" },
        "end_line": { "type": "integer" },
        "symbol": { "type": "string", "description": "Function, class, or variable name if applicable." }
      }
    },
    "rationale": {
      "type": "string",
      "description": "Plain-English explanation of why this finding represents an authentic security risk."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "evidence.schema.json" }
    },
    "remediation": {
      "$ref": "remediation.schema.json"
    },
    "verification_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_number", "action", "expected_result"],
        "properties": {
          "step_number": { "type": "integer" },
          "action": { "type": "string" },
          "test_command": { "type": "string" },
          "expected_result": { "type": "string" }
        }
      }
    },
    "standards_mapping": {
      "type": "object",
      "properties": {
        "asvs_v4": { "type": "string", "description": "OWASP ASVS v4.0.3 control (e.g. V4.1.1)." },
        "cwe": { "type": "string", "description": "CWE identifier (e.g. CWE-639)." },
        "nist_ssdf": { "type": "string", "description": "NIST SP 800-218 SSDF practice (e.g. PW.5.1)." }
      }
    },
    "limitations": {
      "type": "string",
      "description": "Explicit boundaries of automated static detection for this finding."
    }
  }
}
